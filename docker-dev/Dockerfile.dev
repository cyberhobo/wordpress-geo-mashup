# Development image with PHP, Node.js, Composer, and PHPUnit
ARG PHP_VERSION=8.3

# Use official PHP CLI image as base
FROM php:${PHP_VERSION}-cli-alpine

# Copy Composer from official image
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Install system dependencies
RUN apk add --no-cache \
    # Basic tools
    bash \
    git \
    subversion \
    # Node.js to bootstrap pnpm (pnpm then downloads the project's pinned Node)
    nodejs \
    npm \
    # Build tools for native modules
    make \
    g++ \
    python3 \
    # MySQL client for WordPress tests
    mysql-client

# pnpm switches itself to the version pinned in package.json "packageManager"
RUN npm install -g pnpm

# Install PHP extensions commonly needed for WordPress
RUN docker-php-ext-install \
    mysqli \
    pdo_mysql

# Containers run as the host user (see docker-compose files), which has no
# home directory in the image. Give it a writable one for pnpm, Node.js, and
# Composer caches.
RUN mkdir -m 1777 /home/dev
ENV HOME=/home/dev

# Set working directory
WORKDIR /app

# Default command
CMD ["/bin/bash"]